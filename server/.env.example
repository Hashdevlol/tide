# Copy to .env (gitignored). Every value is optional for local development.

# --- core ---
PORT=3001
NODE_ENV=development            # production disables dev login, dev credits and the tide-dev mock model
TIDE_SECRET=                    # 64 hex chars; HMAC key for sign-in nonces / IP hashes (random per boot if unset)
TIDE_DB=data/tide.db

# --- models ---
# Extra node model names accepted for tide-max (the node agent registers as "tide-max" by default)
TIDE_MAX_NODE_MODELS=

# --- abuse limits (defaults shown) ---
MIN_NODE_ACCOUNT_AGE_HOURS=48   # 0 in development
MAX_NODES_PER_ACCOUNT=10
MAX_NODES_PER_IP=10
API_RATE_LIMIT_PER_MIN=60
SUBSIDY_DAILY_CAP_USD=50        # treasury budget for free prompts (node payouts) per UTC day
SUBSIDY_HOURLY_CAP_USD=3

# --- Solana / USDC (deposits, plan checkout, node payouts). Disabled unless both keys are set. ---
SOLANA_CLUSTER=devnet           # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC; mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
TREASURY_WALLET_KEY=            # base58 or JSON byte array. Hot wallet: pays fees, receives deposits, sends payouts
DEPOSIT_WALLET_KEY=             # 64 hex chars; AES-256-GCM key encrypting custodial deposit wallets
PRIORITY_FEE_MICROLAMPORTS=50000

# --- operator console (/admin). Disabled unless set (16+ chars). ---
ADMIN_SECRET=

# --- web search (optional; keyless DuckDuckGo fallback otherwise) ---
BRAVE_API_KEY=
