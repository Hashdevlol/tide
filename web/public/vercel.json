{
  "rewrites": [
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/earn", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/network", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/r/:code", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }]
}
